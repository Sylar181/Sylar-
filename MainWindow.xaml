<Window x:Class="HarmonyFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鸿蒙应用维护工具" Height="720" Width="1160" MinHeight="600" MinWidth="950"
        Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14" Icon="/app.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <TextBlock Text="鸿蒙应用维护工具" FontSize="26" FontWeight="SemiBold" Foreground="#17233C" />
            <TextBlock Margin="0,5,0,0" Text="内部授权运维 · 设备端 bftpd 受控通道 · 全程审计" Foreground="#64748B" />
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="10" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="设备" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,14" Text="连接已授权测试或企业设备" Foreground="#64748B" TextWrapping="Wrap" />
                    <Button Content="刷新设备" Click="RefreshDevices_Click" HorizontalAlignment="Left" />
                    <Button Content="相册下载" Click="MediaDownload_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <Button Content="HDC 设置" Click="HdcSetup_Click" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="安装或指定本机 hdc.exe（首次使用需配置）" />
                </StackPanel>
                <ListBox x:Name="DevicesList" Margin="0,16,0,0" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ChannelTip}">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E5484D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChannelReady}" Value="True">
                                                    <Setter Property="Fill" Value="#30A46C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PolicyNameText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Margin="12,3,0,0" Text="由设备端 bftpd 受控通道提供" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,12,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="RootSelector" SelectionChanged="RootSelector_SelectionChanged" />
                    <ScrollViewer Grid.Column="1" Margin="14,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                    <Button Grid.Column="2" Content="← 上一级" Click="GoUp_Click" Margin="0,0,8,0" ToolTip="返回上一级目录" />
                    <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新目录" Click="RefreshFiles_Click" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" BorderThickness="0"
                              FontSize="14" RowHeight="36"
                              MouseDoubleClick="FilesGrid_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="FilesGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="FilesGrid_PreviewMouseLeftButtonUp"
                              PreviewKeyDown="FilesGrid_PreviewKeyDown"
                              MouseMove="FilesGrid_MouseMove"
                              AllowDrop="True" DragOver="FilesGrid_DragOver" Drop="FilesGrid_Drop">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="类型 / 大小" Binding="{Binding SizeDisplay}" Width="130" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedDisplay}" Width="165" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal">
                        <Button x:Name="DownloadButton" Content="下载" Click="Download_Click" />
                        <Button x:Name="UploadButton" Content="上传" Click="Upload_Click" Margin="8,0,0,0" />
                        <Button x:Name="RenameButton" Content="重命名" Click="Rename_Click" Margin="8,0,0,0" />
                        <Button x:Name="DeleteButton" Content="删除" Background="#C62828" Click="Delete_Click" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="InstallDropZone" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0" Padding="12,10"
                BorderThickness="1.5" BorderBrush="#C7D2FE" Background="#EEF2FF" CornerRadius="8"
                Cursor="Hand" AllowDrop="True"
                MouseLeftButtonUp="InstallDropZone_Click"
                DragOver="InstallDropZone_DragOver"
                Drop="InstallDropZone_Drop">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⬇" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" Text="将 .hap 安装包拖到此处安装到当前设备（同名应用将覆盖更新），或点击选择文件"
                               VerticalAlignment="Center" Foreground="#1E293B" />
                </StackPanel>
                <TextBlock x:Name="InstallStatusText" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="#334155" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                <ProgressBar x:Name="InstallProgress" Margin="0,8,0,0" Height="5" Width="340"
                             HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
