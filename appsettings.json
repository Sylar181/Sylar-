    "BlockedPathFragments": [ "preferences", "token", "secret", "credential", "database", "login-identifier", ".db" ]
  },
  "MediaAccess": {
    "Enabled": true,
    "MediaRoot": "/storage/media/100/local/files",
    "DownloadFolder": "%Desktop%\\HarmonyDownloads",
    "MediaTypes": { "相册": "Photo", "视频": "Video" }
  }
