{
  "HdcPath": "",
  "HdcInstall": {
    "DownloadUrl": "",
    "DownloadPage": "https://developer.huawei.com/consumer/cn/download/",
    "UsbDriverPage": "https://repo.huaweicloud.com/openharmony/usb-driver/"
  },
  "FtpAccess": {
    "Port": 8100,
    "UserName": "anonymous",
    "Password": "guest",
    "BftpdCommand": "/system/bin/bftpd -D -p 8100"
  },
  "ManagedApplication": {
    "BundleName": "com.hermes.p6game.hm",
    "AbilityName": "EntryAbility",
