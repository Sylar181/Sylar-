<Window x:Class="HarmonyFileManager.HdcSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDC 工具链设置" Width="700" SizeToContent="Height" MinHeight="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="HDC 工具链设置" FontSize="22" FontWeight="SemiBold" Foreground="#17233C" />
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#64748B" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Background="#FFFFFF" CornerRadius="8" Padding="12">
            <ScrollViewer x:Name="LogScroll" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" Foreground="#475569" FontSize="13" LineHeight="20" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Height="6" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <WrapPanel>
                <Button x:Name="AutoDownloadButton" Content="自动下载安装" Click="AutoDownload_Click" Padding="16,6" />
                <Button x:Name="InstallZipButton" Content="选择压缩包并安装" Click="InstallZip_Click" Margin="8,0,0,0" Padding="16,6" />
                <Button x:Name="BrowseExeButton" Content="手动指定 hdc.exe" Click="BrowseExe_Click" Margin="8,0,0,0" Padding="16,6" />
                <Button x:Name="OpenDownloadPageButton" Content="打开官方下载页" Click="OpenDownloadPage_Click" Margin="8,0,0,0" Padding="16,6" Visibility="Collapsed" />
                <Button x:Name="OpenUsbDriverButton" Content="USB 驱动说明" Click="OpenUsbDriver_Click" Margin="8,0,0,0" Padding="16,6" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12"
                       Text="自动安装会把 hdc.exe 放入工具目录 toolchains 下并写回 appsettings.json；USB 连接设备还需安装驱动并完成设备授权。若目标设备支持网络调试(hdc tconn),则无需 USB 驱动。" />
            <Button Content="稍后再说" Click="Close_Click" HorizontalAlignment="Right" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
